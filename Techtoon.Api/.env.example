# Techtoon API Environment Variables
# Copy values to your environment or user-secrets. NEVER commit real values.

# Neon PostgreSQL Connection String
ConnectionStrings__DefaultConnection=Host=your-neon-host.neon.tech;Port=5432;Username=your_user;Password=YOUR_PASSWORD;Database=neondb;SSL Mode=Require;Trust Server Certificate=true

# JWT Secret (MINIMUM 32 characters)
Jwt__Secret=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# JWT Settings
Jwt__Issuer=Techtoon
Jwt__Audience=TechtoonClients
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# CORS (array index syntax for env vars)
Cors__AllowedOrigins__0=https://your-ngrok-domain.ngrok.app
Cors__AllowedOrigins__1=http://localhost:3000