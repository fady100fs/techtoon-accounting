<UserControl x:Class="Techtoon.UI.Pages.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddBtn" Content="سند جديد" MinWidth="92" MinHeight="34" Margin="2" Padding="10,4" Click="AddBtn_Click" />
            <Button x:Name="EditBtn" Content="تعديل" MinWidth="80" MinHeight="34" Margin="2" Padding="10,4" Click="EditBtn_Click" />
            <Button x:Name="DelBtn" Content="حذف" MinWidth="80" MinHeight="34" Margin="2" Padding="10,4" Click="DelBtn_Click" />
            <Button x:Name="RefreshBtn" Content="تحديث" MinWidth="80" MinHeight="34" Margin="2" Padding="10,4" Click="RefreshBtn_Click" />
            <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="14,0,4,0" />
            <TextBox x:Name="SearchBox" Width="200" MinHeight="34" Margin="2" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
            <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="14,0,4,0" />
            <ComboBox x:Name="TypeBox" Width="110" MinHeight="34" Margin="2" SelectionChanged="TypeBox_SelectionChanged">
                <ComboBoxItem Content="الكل" />
                <ComboBoxItem Content="قبض" />
                <ComboBoxItem Content="صرف" />
            </ComboBox>
        </WrapPanel>
        <DataGrid x:Name="Dg" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0" AlternatingRowBackground="#FFF6F6F6" RowHeight="30" FontSize="13" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="70" />
                <DataGridTextColumn Header="رقم السند" Binding="{Binding Voucher}" Width="100" />
                <DataGridTextColumn Header="التاريخ" Binding="{Binding DateStr}" Width="100" />
                <DataGridTextColumn Header="الطرف" Binding="{Binding Party}" Width="170" />
                <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="75" />
                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountStr}" Width="115" />
                <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="70" />
                <DataGridTextColumn Header="الطريقة" Binding="{Binding Method}" Width="100" />
                <DataGridTextColumn Header="الخزينة" Binding="{Binding Treasury}" Width="120" />
                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="TotalsText" Grid.Row="2" Margin="2,8,2,4" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="SchemaText" Grid.Row="3" Margin="2,0,2,4" Foreground="#FF666666" TextWrapping="Wrap" Text="جاهز" />
    </Grid>
</UserControl>