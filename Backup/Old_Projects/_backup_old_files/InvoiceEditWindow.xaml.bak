                                                        <DataTemplate>
                                                            <StackPanel Margin="2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#263238"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Ø¨Ø§Ø±ÙƒÙˆØ¯: " Foreground="#78909C" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Barcode}" Foreground="#00897B" FontSize="11"/>
                                                                    <TextBlock Text="  |  Ù…Ø®Ø²ÙˆÙ†: " Foreground="#78909C" FontSize="11"/>
                                                                    <TextBlock Text="{Binding CurrentStock}" Foreground="#EF6C00" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>

                                        <TextBox x:Name="SearchBoxInner"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="search"
                                                 Padding="6,4"
                                                 BorderBrush="#80CBC4" BorderThickness="1,1,1,2"
                                                 Background="White"
                                                 KeyDown="SearchBox_KeyDown"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ø§Ù„Ø¨Ø§Ø±ÙƒÙˆØ¯ -->
                        <DataGridTextColumn Header="Ø¨Ø§Ø±ÙƒÙˆØ¯" Width="110" Binding="{Binding Barcode}" IsReadOnly="True"/>

                        <!-- Ø§Ù„ÙˆØ­Ø¯Ø© -->
                        <DataGridTextColumn Header="Ø§Ù„ÙˆØ­Ø¯Ø©" Width="70" Binding="{Binding Unit}" IsReadOnly="True"/>

                        <!-- Ø§Ù„ÙƒÙ…ÙŠØ© -->
                        <DataGridTemplateColumn Header="Ø§Ù„ÙƒÙ…ÙŠØ©" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Tag="qty" Padding="4,3" BorderBrush="#E0E0E0" KeyDown="Cell_KeyDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ø§Ù„Ø³Ø¹Ø± -->
                        <DataGridTemplateColumn Header="Ø§Ù„Ø³Ø¹Ø±" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Tag="price" Padding="4,3" BorderBrush="#E0E0E0" KeyDown="Cell_KeyDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ø§Ù„Ø®ØµÙ… -->
                        <DataGridTemplateColumn Header="Ø®ØµÙ…" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Tag="discount" Padding="4,3" BorderBrush="#E0E0E0" KeyDown="Cell_KeyDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠ -->
                        <DataGridTextColumn Header="Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠ" Width="110" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#00695C"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Ø­Ø°Ù -->
                        <DataGridTemplateColumn Header="Ø­Ø°Ù" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="ðŸ—‘" Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"
                                            Command="{Binding DataContext.DeleteLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ======================= Ù‚Ø³Ù… Ø§Ù„Ø¯ÙØ¹ Ù…ØªØ¹Ø¯Ø¯ Ø§Ù„Ø·Ø±Ù‚ (ÙŠØ¸Ù‡Ø± Ø¯Ø§Ø¦Ù…Ø§Ù‹) ======================= -->
        <Border x:Name="PaymentsSection" Grid.Row="2" Background="White" Margin="10,4,10,4" Padding="10" BorderBrush="#80CBC4" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ø¹Ù†ÙˆØ§Ù† Ø§Ù„Ù‚Ø³Ù… -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="ðŸ’³" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ø·Ø±Ù‚ Ø§Ù„Ø¯ÙØ¹ Ø§Ù„Ù…ØªØ¹Ø¯Ø¯Ø©" FontSize="15" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Ø¥Ø¶Ø§ÙØ© Ø¯ÙØ¹Ø©" Style="{StaticResource AddBtn}" Command="{Binding AddPaymentCommand}"/>
                </Grid>

                <!-- Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ø¯ÙØ¹Ø§Øª -->
                <DataGrid x:Name="PaymentsGrid" Grid.Row="1"
                          ItemsSource="{Binding Payments}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#ECEFF1"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          Background="White"
                          FontSize="13"
                          MaxHeight="140"
                          CellEditEnding="PaymentsGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <!-- Ø·Ø±ÙŠÙ‚Ø© Ø§Ù„Ø¯ÙØ¹ -->
                        <DataGridTemplateColumn Header="Ø·Ø±ÙŠÙ‚Ø© Ø§Ù„Ø¯ÙØ¹" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding Method, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Padding="4,2">
                                        <ComboBoxItem Content="Ù†Ù‚Ø¯ÙŠ" Tag="cash"/>
                                        <ComboBoxItem Content="Ø¨Ø·Ø§Ù‚Ø©" Tag="card"/>
                                        <ComboBoxItem Content="ØªØ­ÙˆÙŠÙ„ Ø¨Ù†ÙƒÙŠ" Tag="bank"/>
                                        <ComboBoxItem Content="Ø´ÙŠÙƒ" Tag="check"/>
                                        <ComboBoxItem Content="Ø¢Ø¬Ù„" Tag="credit"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ø§Ù„Ù…Ø¨Ù„Øº -->
                        <DataGridTemplateColumn Header="Ø§Ù„Ù…Ø¨Ù„Øº" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Padding="4,3" BorderBrush="#E0E0E0" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ø§Ù„Ù…Ø±Ø¬Ø¹ -->
                        <DataGridTextColumn Header="Ù…Ø±Ø¬Ø¹ / Ø±Ù‚Ù…" Width="180" Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Ø§Ù„ØªØ§Ø±ÙŠØ® -->
                        <DataGridTemplateColumn Header="ØªØ§Ø±ÙŠØ® Ø§Ù„Ø¯ÙØ¹" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding PaymentDate}" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ù…Ù„Ø§Ø­Ø¸Ø§Øª -->
                        <DataGridTextColumn Header="Ù…Ù„Ø§Ø­Ø¸Ø§Øª" Width="*" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Ø­Ø°Ù -->
                        <DataGridTemplateColumn Header="Ø­Ø°Ù" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="ðŸ—‘" Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"
                                            Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ======================= Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠØ§Øª ÙˆØ§Ù„Ø£Ø²Ø±Ø§Ø± ======================= -->
        <Border Grid.Row="3" Background="White" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ØµÙ Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠØ§Øª + Ø±Ø³Ø§Ù„Ø© Ø§Ù„Ø­Ø§Ù„Ø© -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" TextWrapping="Wrap"/>
