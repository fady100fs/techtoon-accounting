            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= Ø§Ù„ØªØ±ÙˆÙŠØ³Ø© ======================= -->
        <Border Grid.Row="0" Background="White" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ðŸ§¾" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="ÙØ§ØªÙˆØ±Ø©" FontSize="18" FontWeight="Bold" Foreground="#00695C"/>
                        <TextBlock Text="{Binding InvoiceTypeDisplay}" FontSize="12" Foreground="#78909C"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ø§Ù„Ø±Ù‚Ù…:" Style="{StaticResource HeaderLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SerialNumber}" Style="{StaticResource InputBox}" IsReadOnly="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Ø§Ù„ØªØ§Ø±ÙŠØ®:" Style="{StaticResource HeaderLabel}"/>
                    <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding InvoiceDate}" FontSize="13"/>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Ø§Ù„Ù†ÙˆØ¹:" Style="{StaticResource HeaderLabel}"/>
                    <ComboBox Grid.Row="0" Grid.Column="7" Style="{StaticResource InputCombo}"
                              SelectedValue="{Binding InvoiceType}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Ù…Ø¨ÙŠØ¹Ø§Øª" Tag="sales"/>
                        <ComboBoxItem Content="Ù…Ø´ØªØ±ÙŠØ§Øª" Tag="purchase"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ø§Ù„Ø·Ø±Ù:" Style="{StaticResource HeaderLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource InputCombo}"
                              ItemsSource="{Binding Parties}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding PartyId}"/>

                    <TextBlock Grid.Row="2" Grid.Column="6" Text="Ø§Ù„Ù…Ø®Ø²Ù†:" Style="{StaticResource HeaderLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="7" Style="{StaticResource InputCombo}"
                              ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding WarehouseId}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ======================= Ø¨Ù†ÙˆØ¯ Ø§Ù„ÙØ§ØªÙˆØ±Ø© + Ø§Ù„Ø¨Ø­Ø« ======================= -->
        <Border Grid.Row="1" Background="White" Margin="10,8,10,4" Padding="8" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Ø´Ø±ÙŠØ· Ø§Ù„Ø¨Ù†ÙˆØ¯ -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ø¨Ù†ÙˆØ¯ Ø§Ù„ÙØ§ØªÙˆØ±Ø©" FontSize="15" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ Ø¥Ø¶Ø§ÙØ© ØµÙ†Ù" Style="{StaticResource AddBtn}" Command="{Binding AddLineCommand}"/>
                </Grid>

                <!-- Ø´Ø¨ÙƒØ© Ø§Ù„Ø¨Ù†ÙˆØ¯ Ù…Ø¹ Ø§Ù„Ø¨Ø­Ø« Ø§Ù„ÙÙˆØ±ÙŠ -->
                <DataGrid x:Name="LinesGrid" Grid.Row="1"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#ECEFF1"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          FontSize="13"
                          MinHeight="180">
                    <DataGrid.Columns>
                        <!-- Ø§Ù„Ø¨Ø­Ø« + Ø§Ø³Ù… Ø§Ù„ØµÙ†Ù -->
                        <DataGridTemplateColumn Header="ðŸ” Ø§Ù„ØµÙ†Ù (Ø§ÙƒØªØ¨ Ù„Ù„Ø¨Ø­Ø« Ø¨Ø§Ù„Ø§Ø³Ù…/Ø§Ù„Ø¨Ø§Ø±ÙƒÙˆØ¯)" Width="320">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Popup Ù†ØªØ§Ø¦Ø¬ Ø§Ù„Ø¨Ø­Ø« -->
                                        <Popup IsOpen="{Binding IsPopupOpen}" Placement="Bottom"
                                               PlacementTarget="{Binding ElementName=SearchBoxInner}"
                                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                            <Border Background="White" BorderBrush="#00897B" BorderThickness="1" CornerRadius="2"
