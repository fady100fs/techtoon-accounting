<Application x:Class="Techtoon.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Techtoon.UI.Converters"
             xmlns:local="clr-namespace:Techtoon.UI">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#00897B"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#00695C"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#607D8B"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#E53935"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#43A047"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="#1A2B3C"/>
            <SolidColorBrush x:Key="CardBrush" Color="White"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FB8C00"/>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Tahoma"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Tahoma"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="Tahoma"/>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="FontFamily" Value="Tahoma"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="#00897B"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#00695C"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#B0BEC5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#B0BEC5"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2A3B4C"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#00695C"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="15"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverterCustom"/>
            <conv:BoolToVisibilityInvertedConverter x:Key="BoolToVisInvertedConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>