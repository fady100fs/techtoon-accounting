<UserControl x:Class="Techtoon.UI.Views.StockLevelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#x623;&#x631;&#x635;&#x62F;&#x629; &#x627;&#x644;&#x645;&#x62E;&#x632;&#x648;&#x646;" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F504; &#x62A;&#x62D;&#x62F;&#x64A;&#x62B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshCommand}"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D; &#x628;&#x62D;&#x62B;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="30" FontSize="13" Padding="6,4"/>
                <Button Content="&#x628;&#x62D;&#x62B;" Command="{Binding SearchCommand}" Width="80" Height="30" Margin="8,0,0,0" Background="#00897B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Levels}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x635;&#x646;&#x641;" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x628;&#x627;&#x631;&#x643;&#x648;&#x62F;" Binding="{Binding Barcode}" Width="120"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x62E;&#x632;&#x646;" Binding="{Binding Warehouse}" Width="100"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A;" Binding="{Binding TotalDisplay}" Width="80"/>
                    <DataGridTextColumn Header="&#x645;&#x62A;&#x627;&#x62D;" Binding="{Binding AvailableDisplay}" Width="80"/>
                    <DataGridTextColumn Header="&#x645;&#x62D;&#x62C;&#x648;&#x632;" Binding="{Binding ReservedDisplay}" Width="80"/>
                    <DataGridTextColumn Header="&#x62A;&#x627;&#x644;&#x641;" Binding="{Binding DamagedDisplay}" Width="80"/>
                    <DataGridTextColumn Header="&#x62A;&#x62D;&#x62A; &#x641;&#x62D;&#x635;" Binding="{Binding UnderInspectionDisplay}" Width="90"/>
                    <DataGridTextColumn Header="&#x62A;&#x643;&#x644;&#x641;&#x629;" Binding="{Binding UnitCost, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="&#x642;&#x64A;&#x645;&#x629;" Binding="{Binding StockValueDisplay}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>