        private void FillTypeCombo()
        {
            try
            {
                CmbType.Items.Clear();
                CmbType.Items.Add(new ComboBoxItem { Content = "\u0645\u0628\u064A\u0639\u0627\u062A", Tag = "sales" });
                CmbType.Items.Add(new ComboBoxItem { Content = "\u0645\u0634\u062A\u0631\u064A\u0627\u062A", Tag = "purchase" });
            }
            catch { }
        }

        private void FillPaymentMethods()
        {
        }

        private void ItemSearchCombo_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                if (_isArrowNav) return;
                if (sender is ComboBox cb && cb.SelectedItem is ItemSearchResult item && cb.DataContext is InvoiceLineItem line)
                {
                    line.SelectItem(item);
                    cb.Text = item.Name;
                }
            }
            catch { }
        }

        private void ItemSearchCombo_TextChanged(object sender, TextChangedEventArgs e)
        {
            try
            {
                if (sender is ComboBox cb)
                {
                    if (!cb.IsDropDownOpen && !string.IsNullOrEmpty(cb.Text))
                        cb.IsDropDownOpen = true;
                    if (cb.DataContext is InvoiceLineItem line)
                    {
                        line.SearchText = cb.Text;
                        cb.ItemsSource = line.FilteredItems;
                    }
                }
            }
            catch { }
        }

        private void ItemSearchCombo_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            try
            {
                if (sender is not ComboBox cb) return;
                if (cb.DataContext is not InvoiceLineItem line) return;

                if (!cb.IsDropDownOpen && (e.Key == Key.Down || e.Key == Key.Up || e.Key == Key.Enter))
                {
                    cb.IsDropDownOpen = true;
                    if (cb.Items.Count > 0) cb.SelectedIndex = 0;
                    e.Handled = true;
                    return;
                }

                switch (e.Key)
                {
                    case Key.Down:
                        if (cb.Items.Count > 0)
                        {
                            _isArrowNav = true;
                            if (cb.SelectedIndex < 0) cb.SelectedIndex = 0;
                            else if (cb.SelectedIndex < cb.Items.Count - 1) cb.SelectedIndex++;
                            _isArrowNav = false;
                            e.Handled = true;
                        }
                        break;
                    case Key.Up:
                        if (cb.Items.Count > 0)
                        {
                            _isArrowNav = true;
                            if (cb.SelectedIndex < 0) cb.SelectedIndex = cb.Items.Count - 1;
                            else if (cb.SelectedIndex > 0) cb.SelectedIndex--;
                            _isArrowNav = false;
                            e.Handled = true;
                        }
                        break;
                    case Key.Enter:
                        if (cb.IsDropDownOpen && cb.SelectedIndex >= 0 && cb.Items[cb.SelectedIndex] is ItemSearchResult item)
                        {
                            line.SelectItem(item);
                            cb.Text = item.Name;
                            cb.IsDropDownOpen = false;
                            Dispatcher.BeginInvoke(new Action(() =>
                            {
                                try
                                {
                                    LinesGrid.CommitEdit(DataGridEditingUnit.Cell, true);
                                    LinesGrid.CommitEdit(DataGridEditingUnit.Row, true);
                                    if (LinesGrid.ItemContainerGenerator.ContainerFromItem(line) is DataGridRow row)
                                    {
                                        var tb = FindDescendant<TextBox>(row, x => (x.Tag as string) == "qty");
                                        tb?.Focus();
                                        tb?.SelectAll();
                                    }
                                }
                                catch { }
                            }), System.Windows.Threading.DispatcherPriority.Input);
                        }
                        e.Handled = true;
                        break;
                    case Key.Escape:
                        cb.IsDropDownOpen = false;
                        e.Handled = true;
                        break;
                }
            }
            catch { }
        }

        private void LinesGrid_PreviewKeyDown(object sender, KeyEventArgs e)
        {
        }

        private void Cell_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key != Key.Enter) return;
            if (sender is not TextBox tb) return;
            if (tb.Tag is not string tag) return;
            if (tb.DataContext is not InvoiceLineItem line) return;
            LinesGrid.CommitEdit(DataGridEditingUnit.Row, true);
            int idx = _vm.Lines.IndexOf(line);
            int last = _vm.Lines.Count - 1;
            if (idx >= 0 && idx < last)
            {
                if (LinesGrid.ItemContainerGenerator.ContainerFromIndex(idx + 1) is DataGridRow nextRow)
                {
                    var next = FindDescendant<TextBox>(nextRow, x => (x.Tag as string) == tag);
                    if (next != null) { next.Focus(); next.SelectAll(); }
                }
            }
            else if (idx == last)
            {
                _vm.AddLineCommand.Execute(null);
                LinesGrid.UpdateLayout();
                if (LinesGrid.ItemContainerGenerator.ContainerFromIndex(_vm.Lines.Count - 1) is DataGridRow newRow)
                {
                    var cb = FindDescendant<ComboBox>(newRow, x => x.Name == "ItemSearchCombo");
                    cb?.Focus();
                }
            }
            e.Handled = true;
        }

        private static T? FindDescendant<T>(DependencyObject? parent, Func<T, bool> predicate) where T : class
        {
            if (parent == null) return null;
            int count = VisualTreeHelper.GetChildrenCount(parent);
            for (int i = 0; i < count; i++)
            {
                var child = VisualTreeHelper.GetChild(parent, i);
                if (child is T matched && predicate(matched)) return matched;
                var deep = FindDescendant(child, predicate);
                if (deep != null) return deep;
            }
            return null;
        }

        private void PaymentsGrid_CellEditEnding(object sender, DataGridCellEditEndingEventArgs e)
        {
            if (e.EditAction == DataGridEditAction.Commit) _vm.RefreshTotals();
        }
    }
