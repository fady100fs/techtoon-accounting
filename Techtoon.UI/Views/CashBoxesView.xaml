<UserControl x:Class="Techtoon.UI.Views.CashBoxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblTitle" Grid.Column="0" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button x:Name="BtnAdd" Grid.Column="1" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="4,0" Command="{Binding AddCommand}"/>
            <Button x:Name="BtnEdit" Grid.Column="2" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="4,0" Command="{Binding EditCommand}"/>
            <Button x:Name="BtnDelete" Grid.Column="3" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" Command="{Binding DeleteCommand}"/>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA" MouseDoubleClick="Dg_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn x:Name="ColCode" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn x:Name="ColType" Binding="{Binding TypeDisplay}" Width="100"/>
                    <DataGridTextColumn x:Name="ColBalance" Binding="{Binding OpeningDisplay}" Width="120"/>
                    <DataGridTextColumn x:Name="ColStatus" Binding="{Binding StatusDisplay}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,5"/>
    </Grid>
</UserControl>
