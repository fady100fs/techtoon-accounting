<Window x:Class="Techtoon.UI.Views.PartyStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x643;&#x634;&#x641; &#x62D;&#x633;&#x627;&#x628;"
        Height="700" Width="1200"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma"
        Background="#FFF5F5F5">
    <DockPanel Margin="16">
        <!-- Top toolbar -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <!-- Row 1: Party + Dates -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x627;&#x644;&#x637;&#x631;&#x641;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbParty" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" FontSize="13"/>
                <TextBlock Grid.Column="3" Text="&#x645;&#x646; &#x62A;&#x627;&#x631;&#x64A;&#x62E;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <DatePicker x:Name="dpFrom" Grid.Column="4" Height="32" FontSize="13"/>
                <TextBlock Grid.Column="6" Text="&#x625;&#x644;&#x649; &#x62A;&#x627;&#x631;&#x64A;&#x62E;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <DatePicker x:Name="dpTo" Grid.Column="7" Height="32" FontSize="13"/>
            </Grid>

            <!-- Row 2: Buttons - large and clear -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="btnSearch" Content="&#x1F50E; &#x639;&#x631;&#x636;" 
                        Width="140" Height="40" FontSize="14" FontWeight="Bold" 
                        Margin="0,0,12,0" Click="BtnSearch_Click" 
                        Background="#FF2E7D32" Foreground="White" BorderThickness="0"/>
                <Button x:Name="btnPdf" Content="&#x1F4C4; &#x62A;&#x635;&#x62F;&#x64A;&#x631; PDF" 
                        Width="180" Height="40" FontSize="14" FontWeight="Bold" 
                        Margin="0,0,12,0" Click="BtnPdf_Click" 
                        Background="#FF1565C0" Foreground="White" BorderThickness="0"/>
                <Button x:Name="btnClose" Content="&#x625;&#x644;&#x63A;&#x627;&#x621;" 
                        Width="120" Height="40" FontSize="14" FontWeight="Bold" 
                        Click="BtnClose_Click" 
                        Background="#FFECEFF1" Foreground="#FF37474F" BorderThickness="0"/>
            </StackPanel>

            <!-- Summary cards -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="&#x631;&#x635;&#x64A;&#x62F; &#x627;&#x628;&#x62A;&#x62F;&#x627;&#x626;&#x64A;" Foreground="#FF666666" FontSize="11"/>
                        <TextBlock x:Name="lblOpening" Text="0.00" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A; &#x627;&#x644;&#x641;&#x627;&#x62A;&#x648;&#x631;&#x629;" Foreground="#FF666666" FontSize="11"/>
                        <TextBlock x:Name="lblTotalInvoices" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#FF2E7D32"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="White" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A; &#x627;&#x644;&#x62F;&#x641;&#x639;" Foreground="#FF666666" FontSize="11"/>
                        <TextBlock x:Name="lblTotalPayments" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#FFC62828"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="White" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="&#x631;&#x635;&#x64A;&#x62F; &#x646;&#x647;&#x627;&#x626;&#x64A;" Foreground="#FF666666" FontSize="11"/>
                        <TextBlock x:Name="lblClosing" Text="0.00" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Transactions grid -->
        <DataGrid x:Name="dgTransactions"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF9F9F9" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="&#x627;&#x644;&#x62A;&#x627;&#x631;&#x64A;&#x62E;" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x646;&#x648;&#x639;" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x631;&#x62C;&#x639;" Binding="{Binding Reference}" Width="150"/>
                <DataGridTextColumn Header="&#x645;&#x628;&#x64A;&#x646;&#x627;&#x62A;" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="&#x645;&#x62F;&#x64A;&#x646;" Binding="{Binding Debit, StringFormat=0.00}" Width="120"/>
                <DataGridTextColumn Header="&#x62F;&#x627;&#x626;&#x646;" Binding="{Binding Credit, StringFormat=0.00}" Width="120"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x631;&#x635;&#x64A;&#x62F;" Binding="{Binding Balance, StringFormat=0.00}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>