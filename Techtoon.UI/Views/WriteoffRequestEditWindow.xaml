<Window x:Class="Techtoon.UI.Views.WriteoffRequestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x637;&#x644;&#x628; &#x634;&#x637;&#x628;"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Tahoma" Background="#F5F7FA">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="lblTitle" Text="&#x637;&#x644;&#x628; &#x634;&#x637;&#x628; &#x62C;&#x62F;&#x64A;&#x62F;" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x627;&#x644;&#x635;&#x646;&#x641;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbItem" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" FontSize="13" SelectionChanged="CmbItem_SelectionChanged"/>
                <TextBlock Grid.Column="3" Text="&#x627;&#x644;&#x645;&#x62E;&#x632;&#x646;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbWarehouse" Grid.Column="4" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" FontSize="13"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x627;&#x644;&#x643;&#x645;&#x64A;&#x629;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <TextBox x:Name="txtQty" Grid.Column="1" Height="30" FontSize="13" Padding="6,4" TextChanged="TxtQty_TextChanged"/>
                <TextBlock Grid.Column="3" Text="&#x62A;&#x643;&#x644;&#x641;&#x629; &#x627;&#x644;&#x648;&#x62D;&#x62F;&#x629;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <TextBox x:Name="txtUnitCost" Grid.Column="4" Height="30" FontSize="13" Padding="6,4" IsReadOnly="True" Background="#F5F5F5"/>
                <TextBlock Grid.Column="6" Text="&#x627;&#x644;&#x642;&#x64A;&#x645;&#x629;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <TextBox x:Name="txtTotalValue" Grid.Column="7" Height="30" FontSize="13" Padding="6,4" IsReadOnly="True" Background="#F5F5F5"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x627;&#x644;&#x625;&#x62C;&#x631;&#x627;&#x621; &#x627;&#x644;&#x645;&#x642;&#x62A;&#x631;&#x62D;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbAction" Grid.Column="1" Height="32" FontSize="13">
                    <ComboBoxItem Content="&#x634;&#x637;&#x628; &#x646;&#x647;&#x627;&#x626;&#x64A;" Tag="writeoff" IsSelected="True"/>
                    <ComboBoxItem Content="&#x628;&#x64A;&#x639; &#x643;&#x647;&#x648;" Tag="sell_as_is"/>
                    <ComboBoxItem Content="&#x625;&#x631;&#x62C;&#x627;&#x639; &#x644;&#x644;&#x645;&#x648;&#x631;&#x62F;" Tag="return_supplier"/>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="&#x633;&#x628;&#x628; &#x627;&#x644;&#x634;&#x637;&#x628;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbReason" Grid.Column="4" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" FontSize="13"/>
            </Grid>

            <TextBlock Text="&#x645;&#x644;&#x627;&#x62D;&#x638;&#x627;&#x62A;:" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNotes" Height="50" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13" Padding="6,4"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="btnSave" Content="&#x62D;&#x641;&#x638;" Width="100" Height="38" Margin="0,0,8,0" Click="BtnSave_Click" Background="#FF00897B" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="btnSubmit" Content="&#x62A;&#x633;&#x644;&#x64A;&#x645; &#x644;&#x627;&#x639;&#x62A;&#x645;&#x627;&#x62F;" Width="140" Height="38" Margin="0,0,8,0" Click="BtnSubmit_Click" Background="#FF1565C0" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="btnApprove" Content="&#x627;&#x639;&#x62A;&#x645;&#x627;&#x62F;" Width="110" Height="38" Margin="0,0,8,0" Click="BtnApprove_Click" Background="#FF2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="btnExecute" Content="&#x62A;&#x646;&#x641;&#x64A;&#x630;" Width="110" Height="38" Margin="0,0,8,0" Click="BtnExecute_Click" Background="#FF6A1B9A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="btnClose" Content="&#x625;&#x644;&#x63A;&#x627;&#x621;" Width="100" Height="38" Click="BtnClose_Click" Background="#FFECEFF1" Foreground="#FF37474F" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </DockPanel>
</Window>