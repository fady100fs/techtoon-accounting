<Window x:Class="Techtoon.UI.Views.DamagedItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x635;&#x646;&#x641; &#x62A;&#x627;&#x644;&#x641;"
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Tahoma" Background="#F5F7FA">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="lblTitle" Text="&#x635;&#x646;&#x641; &#x62A;&#x627;&#x644;&#x641; &#x62C;&#x62F;&#x64A;&#x62F;" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x627;&#x644;&#x635;&#x646;&#x641;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbItem" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" FontSize="13" SelectionChanged="CmbItem_SelectionChanged"/>
                <TextBlock Grid.Column="3" Text="&#x627;&#x644;&#x645;&#x62E;&#x632;&#x646;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbWarehouse" Grid.Column="4" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" FontSize="13"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x627;&#x644;&#x643;&#x645;&#x64A;&#x629;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <TextBox x:Name="txtQty" Grid.Column="1" Height="30" FontSize="13" Padding="6,4" TextChanged="TxtQty_TextChanged"/>
                <TextBlock Grid.Column="3" Text="&#x62A;&#x643;&#x644;&#x641;&#x629; &#x627;&#x644;&#x648;&#x62D;&#x62F;&#x629;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <TextBox x:Name="txtUnitCost" Grid.Column="4" Height="30" FontSize="13" Padding="6,4" IsReadOnly="True" Background="#F5F5F5"/>
                <TextBlock Grid.Column="6" Text="&#x627;&#x644;&#x642;&#x64A;&#x645;&#x629;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <TextBox x:Name="txtTotalValue" Grid.Column="7" Height="30" FontSize="13" Padding="6,4" IsReadOnly="True" Background="#F5F5F5"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x633;&#x628;&#x628; &#x627;&#x644;&#x62A;&#x644;&#x641;:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbReason" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" FontSize="13"/>
            </Grid>

            <TextBlock Text="&#x645;&#x644;&#x627;&#x62D;&#x638;&#x627;&#x62A;:" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNotes" Height="50" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13" Padding="6,4"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="btnSave" Content="&#x62D;&#x641;&#x638;" Width="100" Height="38" Margin="0,0,8,0" Click="BtnSave_Click" Background="#FF00897B" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="btnStartInspection" Content="&#x628;&#x62F;&#x62A; &#x627;&#x644;&#x641;&#x62D;&#x635;" Width="120" Height="38" Margin="0,0,8,0" Click="BtnStartInspection_Click" Background="#FF1565C0" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="btnCompleteInspection" Content="&#x62A;&#x645; &#x627;&#x644;&#x641;&#x62D;&#x635;" Width="120" Height="38" Margin="0,0,8,0" Click="BtnCompleteInspection_Click" Background="#FF2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="btnClose" Content="&#x625;&#x644;&#x63A;&#x627;&#x621;" Width="100" Height="38" Click="BtnClose_Click" Background="#FFECEFF1" Foreground="#FF37474F" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>

        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8" Visibility="Collapsed" x:Name="pnlInspection">
            <StackPanel>
                <TextBlock Text="&#x646;&#x62A;&#x64A;&#x62C;&#x629; &#x627;&#x644;&#x641;&#x62D;&#x635;" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="cmbInspectionResult" Height="32" FontSize="13" Margin="0,0,0,8">
                    <ComboBoxItem Content="&#x625;&#x635;&#x644;&#x627;&#x62D;" Tag="repair"/>
                    <ComboBoxItem Content="&#x625;&#x631;&#x62C;&#x627;&#x639; &#x644;&#x644;&#x645;&#x648;&#x631;&#x62F;" Tag="return_supplier"/>
                    <ComboBoxItem Content="&#x625;&#x639;&#x627;&#x62F;&#x629; &#x644;&#x644;&#x645;&#x62E;&#x632;&#x648;&#x646;" Tag="back_to_stock"/>
                    <ComboBoxItem Content="&#x628;&#x64A;&#x639; &#x643;&#x647;&#x648;" Tag="sell_as_is"/>
                    <ComboBoxItem Content="&#x634;&#x637;&#x628;" Tag="writeoff"/>
                </ComboBox>
                <TextBlock Text="&#x645;&#x644;&#x627;&#x62D;&#x638;&#x627;&#x62A; &#x627;&#x644;&#x641;&#x62D;&#x635;:" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="txtInspectionNotes" Height="50" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13" Padding="6,4"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>