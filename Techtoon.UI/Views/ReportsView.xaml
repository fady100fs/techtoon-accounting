<UserControl x:Class="Techtoon.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Tahoma"
             Background="#FFF5F5F5">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="&#x627;&#x644;&#x62A;&#x642;&#x627;&#x631;&#x64A;&#x631;" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

            <!-- Report type toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="rbSales" Content="&#x62A;&#x642;&#x631;&#x64A;&#x631; &#x627;&#x644;&#x645;&#x628;&#x64A;&#x639;&#x627;&#x62A;"
                             IsChecked="True" Margin="0,0,16,0" Click="ReportType_Click"/>
                <RadioButton x:Name="rbInventory" Content="&#x62A;&#x642;&#x631;&#x64A;&#x631; &#x627;&#x644;&#x62C;&#x631;&#x62F;"
                             Click="ReportType_Click"/>
            </StackPanel>

            <!-- Period quick buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="&#x627;&#x644;&#x64A;&#x648;&#x645;" Command="{Binding TodayCommand}" Width="70" Height="28" Margin="0,0,6,0"/>
                <Button Content="&#x623;&#x633;&#x628;&#x648;&#x639;" Command="{Binding WeekCommand}" Width="70" Height="28" Margin="0,0,6,0"/>
                <Button Content="&#x634;&#x647;&#x631;" Command="{Binding MonthCommand}" Width="70" Height="28" Margin="0,0,6,0"/>
                <Button Content="&#x631;&#x628;&#x639; &#x633;&#x646;&#x629;" Command="{Binding QuarterCommand}" Width="80" Height="28" Margin="0,0,6,0"/>
                <Button Content="&#x633;&#x646;&#x629;" Command="{Binding YearCommand}" Width="70" Height="28" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" Foreground="#FF666666" FontStyle="Italic"/>
            </StackPanel>

            <!-- Date pickers + Search button + Export button -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="&#x645;&#x646; &#x62A;&#x627;&#x631;&#x64A;&#x62E;:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dpFrom" SelectedDate="{Binding FromDate}" Width="150" Height="28"/>
                <TextBlock Text="&#x625;&#x644;&#x649; &#x62A;&#x627;&#x631;&#x64A;&#x62E;:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <DatePicker x:Name="dpTo" SelectedDate="{Binding ToDate}" Width="150" Height="28"/>

                <Button Command="{Binding SearchCommand}" Width="100" Height="28" Margin="14,0,0,0"
                        Background="#FF2E7D32" Foreground="White" FontWeight="Bold" ToolTip="&#x62A;&#x623;&#x643;&#x64A;&#x62F; &#x627;&#x644;&#x641;&#x62A;&#x631;&#x629; &#x648;&#x62A;&#x62D;&#x645;&#x64A;&#x644; &#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A;">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50E;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="&#x628;&#x62D;&#x62B;" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button Content="&#x62A;&#x635;&#x62F;&#x64A;&#x631; PDF" Command="{Binding ExportPdfCommand}"
                        Width="170" Height="38" Margin="14,0,0,0" FontSize="14"
                        Background="#FF1565C0" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Sales report grid -->
        <DataGrid x:Name="dgSales"
                  ItemsSource="{Binding SalesData}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="&#x627;&#x644;&#x62A;&#x627;&#x631;&#x64A;&#x62E;" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
                <DataGridTextColumn Header="&#x631;&#x642;&#x645; &#x627;&#x644;&#x641;&#x627;&#x62A;&#x648;&#x631;&#x629;" Binding="{Binding InvoiceNumber}" Width="150"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x639;&#x645;&#x64A;&#x644;" Binding="{Binding PartyName}" Width="200"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A;" Binding="{Binding Total, StringFormat=0.00}" Width="120"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x62F;&#x641;&#x648;&#x639;" Binding="{Binding Paid, StringFormat=0.00}" Width="120"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x62A;&#x628;&#x642;&#x64A;" Binding="{Binding Remaining, StringFormat=0.00}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Inventory report grid -->
        <DataGrid x:Name="dgInventory"
                  ItemsSource="{Binding InventoryData}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF9F9F9"
                  Visibility="Collapsed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="&#x627;&#x644;&#x635;&#x646;&#x641;" Binding="{Binding ItemName}" Width="250"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x628;&#x627;&#x631;&#x643;&#x648;&#x62F;" Binding="{Binding Barcode}" Width="150"/>
                <DataGridTextColumn Header="&#x627;&#x644;&#x643;&#x645;&#x64A;&#x629;" Binding="{Binding StockQty, StringFormat=0.00}" Width="100"/>
                <DataGridTextColumn Header="&#x645;&#x62A;&#x648;&#x633;&#x637; &#x627;&#x644;&#x62A;&#x643;&#x644;&#x641;&#x629;" Binding="{Binding AvgCost, StringFormat=0.00}" Width="130"/>
                <DataGridTextColumn Header="&#x633;&#x639;&#x631; &#x627;&#x644;&#x628;&#x64A;&#x639;" Binding="{Binding SellPrice, StringFormat=0.00}" Width="120"/>
                <DataGridTextColumn Header="&#x642;&#x64A;&#x645;&#x629; &#x627;&#x644;&#x645;&#x62E;&#x632;&#x648;&#x646;" Binding="{Binding StockValue, StringFormat=0.00}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
