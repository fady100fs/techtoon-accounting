<UserControl x:Class="Techtoon.UI.Views.DataManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="&#x625;&#x62F;&#x631;&#x629; &#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x648;&#x625;&#x639;&#x627;&#x62F;&#x629; &#x636;&#x628;&#x637; &#x627;&#x644;&#x645;&#x635;&#x646;&#x639;" FontSize="22" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,20"/>

            <!-- Warning Banner -->
            <Border Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="2" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="&#x26A0;&#xFE0F; &#x62A;&#x62D;&#x630;&#x64A;&#x631;: &#x623;&#x64A; &#x639;&#x645;&#x644;&#x64A;&#x629; &#x62D;&#x630;&#x641; &#x644;&#x627; &#x62A;&#x645;&#x62A; &#x627;&#x644;&#x639;&#x648;&#x62F;&#x629;." FontSize="16" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x64A;&#x62C;&#x628; &#x625;&#x646;&#x634;&#x627;&#x621; &#x646;&#x633;&#x62E;&#x629; &#x627;&#x62D;&#x62A;&#x64A;&#x627;&#x637;&#x64A;&#x629; &#x642;&#x628;&#x644; &#x623;&#x64A; &#x639;&#x645;&#x644;&#x64A;&#x629;. &#x633;&#x64A;&#x62A;&#x645; &#x637;&#x644;&#x628; &#x627;&#x644;&#x62A;&#x623;&#x643;&#x64A;&#x62F; &#x645;&#x631;&#x62A;&#x64A;&#x646;." FontSize="13" Foreground="#B71C1C"/>
                </StackPanel>
            </Border>

            <!-- Grid for Data Management Options -->
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Invoices -->
                <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#x627;&#x644;&#x645;&#x628;&#x64A;&#x639;&#x627;&#x62A; &#x648;&#x627;&#x644;&#x645;&#x634;&#x62A;&#x631;&#x64A;&#x627;&#x62A;" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                        <TextBlock Text="&#x62D;&#x630;&#x641; &#x627;&#x644;&#x641;&#x648;&#x627;&#x62A;&#x64A;&#x631; &#x648;&#x627;&#x644;&#x645;&#x631;&#x62A;&#x62C;&#x639;&#x627;&#x62A; &#x648;&#x62A;&#x641;&#x627;&#x635;&#x64A;&#x644;&#x647;&#x627; &#x648;&#x62D;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x62E;&#x632;&#x648;&#x646; &#x627;&#x644;&#x645;&#x62A;&#x639;&#x644;&#x642;&#x629;." FontSize="12" Foreground="#546E7A" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Button Content="&#x645;&#x639;&#x627;&#x64A;&#x646;&#x629; &#x648;&#x62D;&#x630;&#x641;" Command="{Binding DeleteInvoicesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>

                <!-- 2. Inventory -->
                <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#x625;&#x62F;&#x631;&#x629; &#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x62E;&#x632;&#x648;&#x646;" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                        <TextBlock Text="&#x62A;&#x635;&#x641;&#x64A;&#x631; &#x627;&#x644;&#x643;&#x645;&#x64A;&#x627;&#x62A; &#x648;&#x62D;&#x630;&#x641; &#x62D;&#x631;&#x643;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x62E;&#x632;&#x648;&#x646; &#x648;&#x627;&#x644;&#x623;&#x631;&#x635;&#x62F;&#x629; &#x627;&#x644;&#x627;&#x641;&#x62A;&#x62A;&#x627;&#x62D;&#x64A;&#x629;." FontSize="12" Foreground="#546E7A" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Button Content="&#x645;&#x639;&#x627;&#x64A;&#x646;&#x629; &#x648;&#x62A;&#x635;&#x641;&#x64A;&#x631;" Command="{Binding ClearInventoryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>

                <!-- 3. Stock Ops -->
                <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#x62C;&#x631;&#x62F; &#x648;&#x62A;&#x633;&#x648;&#x64A;&#x627;&#x62A; &#x648;&#x62A;&#x627;&#x644;&#x641;" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                        <TextBlock Text="&#x62D;&#x630;&#x641; &#x62C;&#x644;&#x633;&#x627;&#x62A; &#x627;&#x644;&#x62C;&#x631;&#x62F; &#x648;&#x627;&#x644;&#x62A;&#x633;&#x648;&#x64A;&#x627;&#x62A; &#x648;&#x637;&#x644;&#x628;&#x627;&#x62A; &#x627;&#x644;&#x634;&#x637;&#x628;." FontSize="12" Foreground="#546E7A" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Button Content="&#x645;&#x639;&#x627;&#x64A;&#x646;&#x629; &#x648;&#x62D;&#x630;&#x641;" Command="{Binding DeleteStockOpsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>

                <!-- 4. Finance -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x627;&#x644;&#x64A;&#x629;" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                        <TextBlock Text="&#x62D;&#x630;&#x641; &#x627;&#x644;&#x645;&#x62F;&#x641;&#x648;&#x639;&#x627;&#x62A; &#x648;&#x627;&#x644;&#x645;&#x635;&#x631;&#x648;&#x641;&#x627;&#x62A; &#x648;&#x627;&#x644;&#x642;&#x64A;&#x648;&#x62F; &#x627;&#x644;&#x645;&#x62D;&#x627;&#x633;&#x628;&#x64A;&#x629;." FontSize="12" Foreground="#546E7A" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Button Content="&#x645;&#x639;&#x627;&#x64A;&#x646;&#x629; &#x648;&#x62D;&#x630;&#x641;" Command="{Binding DeleteFinanceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Factory Reset Section -->
            <Border Background="#FFF3E0" BorderBrush="#EF6C00" BorderThickness="2" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="&#x625;&#x639;&#x627;&#x62F;&#x629; &#x636;&#x628;&#x637; &#x627;&#x644;&#x645;&#x635;&#x646;&#x639; (Factory Reset)" FontSize="18" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,10"/>
                    <TextBlock Text="&#x647;&#x630;&#x647; &#x627;&#x644;&#x639;&#x645;&#x644;&#x64A;&#x629; &#x62A;&#x62D;&#x630;&#x641; &#x62C;&#x645;&#x64A;&#x639; &#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x627;&#x644;&#x639;&#x645;&#x644; &#x648;&#x62A;&#x647;&#x64A;&#x626; &#x627;&#x644;&#x646;&#x638;&#x627;&#x645; &#x644;&#x644;&#x628;&#x62F;&#x621; &#x645;&#x646; &#x62C;&#x62F;&#x64A;&#x62F;. &#x633;&#x64A;&#x62A;&#x645; &#x627;&#x644;&#x627;&#x62D;&#x62A;&#x641;&#x627;&#x638; &#x628;&#x627;&#x644;&#x645;&#x633;&#x62A;&#x62E;&#x62F;&#x645; &#x627;&#x644;&#x625;&#x62F;&#x627;&#x631;&#x64A; &#x648;&#x627;&#x644;&#x623;&#x62F;&#x648;&#x627;&#x631;." FontSize="13" Foreground="#BF360C" Margin="0,0,0,15" TextWrapping="Wrap"/>
                    <Button Content="&#x625;&#x639;&#x627;&#x62F;&#x629; &#x636;&#x628;&#x637; &#x627;&#x644;&#x645;&#x635;&#x646;&#x639;" Command="{Binding FactoryResetCommand}" Background="#FFEF6C00" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>