<UserControl x:Class="Techtoon.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title + Refresh -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblTitle" Grid.Column="0" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#00897B" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <Button x:Name="BtnRefresh" Grid.Column="2" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Row 1: Low Stock Alert Banner -->
            <Border Grid.Row="2" Background="#FFFDE7" BorderBrush="#FFC107" BorderThickness="2" CornerRadius="6" Padding="15,10" Margin="0,0,0,12"
                    Visibility="{Binding HasLowStockAlert, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding LowStockAlertMessage}" FontSize="16" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
            </Border>

            <!-- Row 2: Metrics cards -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Metrics}" Margin="0,0,0,15">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="5" MinWidth="180" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Icon}" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,5,0,2"/>
                                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold" Foreground="{Binding Color}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#78909C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Row 3: Monthly Sales - Horizontal Bar Chart (SAFE) -->
            <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="&#x645;&#x628;&#x64A;&#x639;&#x627;&#x62A; &#x634;&#x647;&#x631;&#x64A;&#x629; (&#x622;&#x62E;&#x631; 6 &#x623;&#x634;&#x647;&#x631;)" FontSize="14" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding MonthlySales}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Label}" Width="80" FontSize="12" Foreground="#546E7A" VerticalAlignment="Center"/>
                                    <Border Width="{Binding BarWidth}" Height="22" Background="#FF00897B" CornerRadius="3" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Sales, StringFormat=0}" FontSize="12" FontWeight="Bold" Foreground="#00897B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Overdue Invoices Table -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,15" BorderBrush="#E0E0E0" BorderThickness="1"
                    Visibility="{Binding HasOverdueAlert, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="فواتير متأخرة (لم تسدد)" FontSize="14" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding OverdueInvoices}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" BorderThickness="0" FontSize="12" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding PartyName}" Width="*"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalDisplay}" Width="100"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingDisplay}" Width="100"/>
                            <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueDateDisplay}" Width="120"/>
                            <DataGridTextColumn Header="أيام التأخير" Binding="{Binding DaysOverdueDisplay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
<!-- Row 4: Top Items + Low Stock Items -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LblTopItems" FontSize="14" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding TopItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" BorderThickness="0" FontSize="12" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="&#x627;&#x644;&#x635;&#x646;&#x641;" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="&#x627;&#x644;&#x643;&#x645;&#x64A;&#x629;" Binding="{Binding Quantity, StringFormat=N2}" Width="80"/>
                                <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A;" Binding="{Binding Total, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LblLowStock" FontSize="14" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding LowStockItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" BorderThickness="0" FontSize="12" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="&#x627;&#x644;&#x635;&#x646;&#x641;" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="&#x627;&#x644;&#x631;&#x635;&#x64A;&#x62F;" Binding="{Binding Quantity, StringFormat=N2}" Width="80"/>
                                <DataGridTextColumn Header="&#x627;&#x644;&#x62D;&#x62F; &#x627;&#x644;&#x623;&#x62F;&#x646;&#x649;" Binding="{Binding Total, StringFormat=N2}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>