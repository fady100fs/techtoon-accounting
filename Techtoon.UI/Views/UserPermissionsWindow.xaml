<Window x:Class="Techtoon.UI.Views.UserPermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x635;&#x644;&#x627;&#x62D;&#x64A;&#x627;&#x62A;"
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Tahoma" Background="#F5F7FA">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="lblTitle" Text="&#x635;&#x644;&#x627;&#x62D;&#x64A;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x633;&#x62A;&#x62E;&#x62F;&#x645;" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="lblUser" Text="" FontSize="14" Foreground="#546E7A" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="btnSave" Content="&#x62D;&#x641;&#x638; &#x627;&#x644;&#x635;&#x644;&#x627;&#x62D;&#x64A;&#x627;&#x62A;" Width="140" Height="38" Margin="0,0,8,0" Click="BtnSave_Click" Background="#FF00897B" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="&#x625;&#x644;&#x63BA;&#x627;&#x621;" Width="100" Height="38" Click="BtnCancel_Click" Background="#FFECEFF1" Foreground="#FF37474F" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>

        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnlPermissions" Margin="10"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>