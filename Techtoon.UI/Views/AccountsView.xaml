<UserControl x:Class="Techtoon.UI.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma"
             Loaded="UserControl_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblTitle" Grid.Column="0" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button x:Name="BtnAddRoot" Grid.Column="1" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding AddRootCommand}"/>
            <Button x:Name="BtnAddChild" Grid.Column="2" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding AddChildCommand}"/>
            <Button x:Name="BtnEdit" Grid.Column="3" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding EditCommand}"/>
            <Button x:Name="BtnDelete" Grid.Column="4" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" Command="{Binding DeleteCommand}"/>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
            <TreeView x:Name="TvAccounts" ItemsSource="{Binding RootAccounts}" SelectedItemChanged="TvAccounts_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#1565C0"/>
                            <TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
                            <TextBlock Text="(" Foreground="#78909C" FontSize="11"/>
                            <TextBlock Text="{Binding TypeDisplay}" Foreground="#78909C" FontSize="11"/>
                            <TextBlock Text=")" Foreground="#78909C" FontSize="11"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
        <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,5"/>
    </Grid>
</UserControl>
