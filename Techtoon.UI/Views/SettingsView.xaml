<UserControl x:Class="Techtoon.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="400">
            <TextBlock x:Name="LblTitle" FontSize="24" FontWeight="Bold" Foreground="#00695C" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock x:Name="LblBackup" FontSize="16" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                    <Button x:Name="BtnBackup" Background="#00897B" Foreground="White" FontWeight="SemiBold" FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10" Command="{Binding BackupCommand}"/>
                    <Button x:Name="BtnRestore" Background="#FB8C00" Foreground="White" FontWeight="SemiBold" FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand" Command="{Binding RestoreCommand}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
