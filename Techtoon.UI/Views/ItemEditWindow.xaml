<Window x:Class="Techtoon.UI.Views.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item" Height="550" Width="500"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#F5F7FA" Loaded="Window_Loaded" FontFamily="Tahoma">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LblTitle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,15"/>

        <TextBlock x:Name="LblName" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,8,5"/>
        <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1" Padding="6,4" Margin="0,3"/>

        <TextBlock x:Name="LblBarcode" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,8,5"/>
        <TextBox x:Name="TxtBarcode" Grid.Row="2" Grid.Column="1" Padding="6,4" Margin="0,3"/>

        <TextBlock x:Name="LblSellPrice" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,8,5"/>
        <TextBox x:Name="TxtSellPrice" Grid.Row="3" Grid.Column="1" Padding="6,4" Margin="0,3" TextAlignment="Right"/>

        <TextBlock x:Name="LblCostPrice" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,8,5"/>
        <TextBox x:Name="TxtCostPrice" Grid.Row="4" Grid.Column="1" Padding="6,4" Margin="0,3" TextAlignment="Right"/>

        <TextBlock x:Name="LblMinStock" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,8,5"/>
        <TextBox x:Name="TxtMinStock" Grid.Row="5" Grid.Column="1" Padding="6,4" Margin="0,3" TextAlignment="Right"/>

        <TextBlock x:Name="LblOpeningQty" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,8,5" FontWeight="Bold" Foreground="#E65100"/>
        <TextBox x:Name="TxtOpeningQty" Grid.Row="6" Grid.Column="1" Padding="6,4" Margin="0,3" TextAlignment="Right" BorderBrush="#FB8C00" BorderThickness="1,1,1,2"/>

        <TextBlock x:Name="LblCategory" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,8,5"/>
        <ComboBox x:Name="CmbCategory" Grid.Row="7" Grid.Column="1" Padding="6,4" Margin="0,3" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <CheckBox x:Name="ChkActive" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Margin="0,5,0,5" IsChecked="True"/>

        <TextBlock x:Name="LblStatus" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Foreground="#00897B" FontSize="12" Margin="0,10,0,5" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Background="#00897B" Foreground="White" FontWeight="Bold" FontSize="14" Padding="30,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Background="#ECEFF1" Foreground="#37474F" FontWeight="SemiBold" FontSize="13" Padding="20,10" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
